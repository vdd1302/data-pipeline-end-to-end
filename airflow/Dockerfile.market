FROM apache/airflow:3.1.8
USER root
RUN apt-get update && apt-get install -y --no-install-recommends chromium chromium-driver xvfb \
    && apt-get clean && rm -rf /var/lib/apt/lists/*
USER airflow
COPY requirements.txt /tmp/market-requirements.txt
RUN pip install --no-cache-dir 'apache-airflow==3.1.8' -r /tmp/market-requirements.txt
