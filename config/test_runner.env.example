# Config available inside Airflow scheduler AND workers (NOT COMMITTED AS .env)
# Do not use the production PostgreSQL DSN.
M87C_ENABLE_TEST=0
M87C_TEST_DB_DSN=postgresql://test_user:REPLACE@host.docker.internal:5432/topcv_raw_storage_test
# Supply a JSON argv array that exactly runs the already audited M8.7A TechJobs API entrypoint.
# EXAMPLE FORMAT ONLY, not the actual M8.7A script path:
M87C_INGEST_COMMAND_JSON=["python","scripts/REPLACE_WITH_REAL_M87A_ENTRYPOINT.py","--mode","ingest"]
# For replay, exact same frozen run_id/batch/hash, NEVER a new API fetch:
M87C_REPLAY_COMMAND_JSON=["python","scripts/REPLACE_WITH_REAL_FROZEN_BATCH_RUNNER.py"]
M87C_TEST_SCHEDULE=*/10 * * * *
M87C_RUN_TIMEOUT_SECONDS=900
